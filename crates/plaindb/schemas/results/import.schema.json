{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "import",
  "type": "object",
  "properties": {
    "imported": { "type": "integer", "minimum": 0 },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["file", "reason"],
        "additionalProperties": false
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "file": { "type": "string" },
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"],
        "oneOf": [{ "required": ["line"] }, { "required": ["file"] }],
        "additionalProperties": false
      }
    }
  },
  "required": ["imported", "omitted", "failed"],
  "additionalProperties": false
}
