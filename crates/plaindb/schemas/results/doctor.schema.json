{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doctor",
  "description": "The report of doctor. When a check has the status error, the response is a failure with the code doctor_failed and this report under error.details.report.",
  "type": "object",
  "properties": {
    "errors": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "integer", "minimum": 0 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "group": { "enum": ["git", "store", "environment"] },
          "status": { "enum": ["ok", "warn", "error"] },
          "message": { "type": "string" },
          "details": { "type": "object" },
          "fix": { "type": ["string", "null"] }
        },
        "required": ["id", "group", "status", "message", "details", "fix"],
        "additionalProperties": false
      }
    }
  },
  "required": ["errors", "warnings", "checks"],
  "additionalProperties": false
}
